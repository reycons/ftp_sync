# ftp_sync — development configuration TEMPLATE
# Copy this file to config/config.dev.yaml and fill in local values.
# config/config.dev.yaml is gitignored and must NEVER be committed.
# Secrets must be in .env — never in this file.
# FTP connections are defined in config/data_feeds/ftp.{name}.yaml files.

# Relative path works for local dev; use absolute path on a server.
log_path: logs/ftp_sync_{operation}_{timestamp}.log

# Central environment key registry.
# Each entry maps a name used in ftp.{name}.yaml to a .env variable.
env:
  - name: ftp_user_example
    env_var: FTP_USER_EXAMPLE
    generate: false
  - name: ftp_password_example
    env_var: FTP_PASSWORD_EXAMPLE
    generate: false

schedule:
  description: "Daily at 06:00 AM"
