# ftp_sync — production configuration TEMPLATE
# Copy this file to config/config.prod.yaml and fill in client-specific values.
# config/config.prod.yaml is gitignored and must NEVER be committed.
# Secrets must be in .env — never in this file.
# FTP connections are defined in config/data_feeds/ftp.{name}.yaml files.

# Absolute path to the log directory on the deployment server.
log_path: C:/path/to/logs/ftp_sync_{operation}_{timestamp}.log

# Central environment key registry.
# Each entry maps a name used in ftp.{name}.yaml to a .env variable.
# Add one entry per FTP connection credential pair.
env:
  - name: ftp_user_example
    env_var: FTP_USER_EXAMPLE
    generate: false
  - name: ftp_password_example
    env_var: FTP_PASSWORD_EXAMPLE
    generate: false

schedule:
  description: "Daily at 05:00 AM"
